{
  "expo": {
    "name": "ASAP",
    "slug": "asap-eats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CC0001"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yawmanuel.asapeats"
    },
    "android": {
      "package": "com.yawmanuel.asapeats"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "53452dd3-a404-40ab-9839-562bcb31def1"
      }
    },
    "owner": "yawmanuel"
  }
}
